import funkin.play.song.Song;
import funkin.save.Save;
import funkin.play.PlayState;
import Date;

class NervesErectSong extends Song
{
  public function new()
  {
    super('nerves', {variation: 'erect'});
  }

  override public function isSongNew(currentDifficulty:String, currentVariation:String):Bool
  {
    if (currentVariation == 'erect')
    {
      return !Save.instance.hasBeatenSong(this.id, Constants.DEFAULT_DIFFICULTY_LIST_ERECT);
    }

    return super.isSongNew(currentDifficulty, currentVariation);
  }

  function onCreate(event:ScriptEvent):Void
  {
    super.onCreate(event);
    if (!FlxG.onMobile)
    {
      PlayState.instance.discordRPCAlbum = "https://raw.githubusercontent.com/LeGooeyy/GooeyMixDiscordIcons/refs/heads/main/assets/album-covers/"
        + PlayState.instance.currentChart.album
        + ".png?raw=true";
      PlayState.instance.discordRPCIcon = "https://raw.githubusercontent.com/LeGooeyy/GooeyMixDiscordIcons/refs/heads/main/assets/icons/"
        + PlayState.instance.currentChart.characters.opponent
        + ".png?raw=true?t="
        + Date.now().getTime();
    }
  }
}
