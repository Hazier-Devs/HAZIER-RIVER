import funkin.data.character.CharacterDataParser;
import funkin.play.event.SongEvent;
import funkin.play.PlayState;
import funkin.Conductor;
import flixel.group.FlxTypedSpriteGroup;
import flixel.tweens.FlxTween;
import flixel.tweens.FlxEase;

using funkin.util.AnsiUtil;

class CharacterSingTrailSongEvent extends SongEvent
{
  /**
   * The default trail target.
   */
  public static final DEFAULT_TARGET:String = 'bf';

  /**
   * The default "active" value.
   */
  public static final DEFAULT_ACTIVE:Bool = true;

  /**
   * The suffix to put on character ids when looking for trails.
   */
  public static final TRAIL_SUFFIX:String = '-trail';

  /**
   * The amount that the trail should move.
   */
  public static final MOVE_AMOUNT:Float = 60;

  public function new()
  {
    super('CharacterSingTrails');
  }

  override public function getTitle():String
  {
    return 'Character Trail Event';
  }

  public var bfTrail:FlxTypedSpriteGroup;

  var trailElapsed:Float = 0;
  var trailActive:Bool = false;

  override public function onCountdownStart(event:CountdownScriptEvent):Void
  {
    super.onCountdownStart(event);
    if (bfTrail != null || currentStage == null) return;

    bfTrail = new FlxTypedSpriteGroup();
    bfTrail.zIndex = (currentStage?.getBoyfriend()?.zIndex ?? 0) - 1;
    currentStage?.add(bfTrail);
    currentStage?.refresh();

    getTrail()?.kill();
  }

  override public function onDestroy(event:ScriptEvent):Void
  {
    super.onDestroy(event);

    trailActive = false;
    bfTrail = null;
  }

  override public function onSongRetry(event:SongRetryEvent):Void
  {
    super.onSongRetry(event);
    trailActive = false;
  }

  override public function handleEvent(data:SongEventData):Void
  {
    if (bfTrail == null) return;

    trailActive = (data.getBool('isActive') ?? data.value) ?? false;
    trailElapsed = Conductor.instance.stepLengthMs / 1000;

    log('Character Trail is now ${trailActive ? 'active' : 'inactive'}!');
  }

  override public function onUpdate(event:UpdateScriptEvent):Void
  {
    super.onUpdate(event);

    if (trailActive)
    {
      final stepLength:Float = Conductor.instance.stepLengthMs / 1000;
      trailElapsed += event.elapsed;

      while (trailElapsed >= stepLength)
      {
        trailElapsed -= stepLength;

        var newOffset:Array<Float> = switch (currentStage.getBoyfriend()?.getCurrentAnimation() ?? '')
        {
          case 'singLEFT':
            [-MOVE_AMOUNT, 0];
          case 'singDOWN':
            [0, MOVE_AMOUNT];
          case 'singUP':
            [0, -MOVE_AMOUNT];
          case 'singRIGHT':
            [MOVE_AMOUNT, 0];
          default:
            null;
        };

        if (newOffset != null)
        {
          var trail:BaseCharacter = getTrail();
          trail.color = 0x66FFFF;
          trail.alpha = 1;

          trail.playAnimation(currentStage.getBoyfriend()?.getCurrentAnimation(), true);
          trail.animation?.curAnim?.curFrame = currentStage.getBoyfriend()?.animation?.curAnim?.curFrame ?? 0;

          FlxTween.tween(trail, {x: trail.x + newOffset[0], y: trail.y + newOffset[1], alpha: 0}, 2 * (Conductor.instance.beatLengthMs / 1000),
            {
              ease: FlxEase.circOut,
              onComplete: (_) -> trail.kill()
            });
        }
      }
    }
  }

  function getTrail():BaseCharacter
  {
    var character:BaseCharacter = null;

    for (sprite in bfTrail.members)
    {
      if (sprite.alive) continue;

      character = sprite;
      break;
    }

    if (character == null)
    {
      final realBF:BaseCharacter = currentStage?.getBoyfriend();
      character = CharacterDataParser.fetchCharacter('${realBF.characterId}${TRAIL_SUFFIX}');

      currentStage?.addCharacter(character, realBF.characterType);
      currentStage?.characters.set('bf', realBF);

      currentStage?.remove(character);
      bfTrail.add(character);
    }

    character.resetCharacter(false);

    bfTrail.remove(character, true);
    bfTrail.add(character);

    bfTrail.revive();
    return character;
  }

  override public function getEventSchema():SongEventSchema
  {
    return [
      {
        name: 'isActive',
        title: 'Active?',
        defaultValue: DEFAULT_ACTIVE,
        type: 'bool'
      }
    ];
  }

  static function log(text:String):Void
  {
    trace('${' HAZIER RIVER '.bold().bg_bright_cyan()} $text');
  }

  var currentStage(get, never):Stage;

  function get_currentStage():Stage
  {
    return PlayState.instance?.currentStage;
  }
}
