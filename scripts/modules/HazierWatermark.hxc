import funkin.ui.mainmenu.MainMenuState;
import funkin.modding.PolymodHandler;
import funkin.modding.module.Module;
import thx.semver.Version;

class HazierWatermark extends Module
{
  /**
   * Mod ID used for Hazier River.
   */
  public static final HAZIER_MOD_ID:String = 'hazier-river';

  public function new()
  {
    super('hazierWatermark', 1000, {state: MainMenuState});
  }

  override public function onStateChangeEnd(event:StateChangeScriptEvent):Void
  {
    super.onStateChangeEnd(event);
    if (!Std.isOfType(event.targetState, MainMenuState)) return;

    var metadata:ModMetadata = PolymodHandler.modFileSystem.getMetadataById(HAZIER_MOD_ID);

    var version:String = Version.toString(metadata.modVersion);
    var title:String = metadata.title;

    var leftWatermarkText:FlxText = event.targetState.leftWatermarkText;

    leftWatermarkText.y -= leftWatermarkText.height;
    leftWatermarkText.text = '${title} v${version}\n${leftWatermarkText.text}';
  }
}
